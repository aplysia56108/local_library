/*
https://atcoder.jp/contests/abc311/submissions/43902219
を参考に
https://en.wikipedia.org/wiki/Cartesian_tree

root:min
*/
template <typename T>
struct Cartesian_Tree {
    int root;
    vi l, r;
    Cartesian_Tree() {
    }
    Cartesian_Tree(const vector<T> &a) {
        int n = a.size();
        l = r = vi(n, -1);
        vector<int> s(n);
        int si = -1;
        rep(i, n) {
            while (~si && a[i] < a[s[si]]) l[i] = s[si--];  // > max
            if (~si) r[s[si]] = i;
            s[++si] = i;
        }
        root = s[0];
    }
};

