https://math314.hateblo.jp/entry/2015/05/07/014908
を参考に

int32mod_convolution(vector<ll> a, vector<ll> b, int mod):O(n log n)
*/

template <class T>
T extgcd(T a, T b, T &x, T &y) {
    for (T u = y = 1, v = x = 0; a;) {
        T q = b / a;
        swap(x -= q * u, u);
        swap(y -= q * v, v);
        swap(b -= q * a, a);
    }
    return b;
}
template <class T>
T inv_mod(T a, T m) {
    T x, y;
    extgcd(a, m, x, y);
    return (m + x % m) % m;
}

template <int mod, int primitive_root>
class NTT {
   public:
    int get_mod() const {
        return mod;
    }
    void _ntt(vector<ll> &a, int sign) {
        const int n = a.size();
        assert((n ^ (n & -n)) == 0);  // n = 2^k

        const int g = 3;  // g is primitive root of mod
        int h = (int)pow_mod(g, (mod - 1) / n, mod);  // h^n = 1
        if (sign == -1) h = (int)inv_mod(h, mod);     // h = h^-1 % mod

        // bit reverse
        int i = 0;
        for (int j = 1; j < n - 1; ++j) {
            for (int k = n >> 1; k > (i ^= k); k >>= 1)
                ;
            if (j < i) swap(a[i], a[j]);
        }

        for (int m = 1; m < n; m *= 2) {
            const int m2 = 2 * m;
            const ll base = pow_mod(h, n / m2, mod);
            ll w = 1;
            rep(x, m) {
                for (int s = x; s < n; s += m2) {
                    ll u = a[s];
                    ll d = a[s + m] * w % mod;
                    a[s] = u + d;
                    if (a[s] >= mod) a[s] -= mod;
                    a[s + m] = u - d;
                    if (a[s + m] < 0) a[s + m] += mod;
                }
                w = w * base % mod;
            }
        }

        for (auto &x : a)
            if (x < 0) x += mod;
    }
    void ntt(vector<ll> &input) {
        _ntt(input, 1);
    }
    void intt(vector<ll> &input) {
        _ntt(input, -1);
        const int n_inv = inv_mod((int)input.size(), mod);
        for (auto &x : input) x = x * n_inv % mod;
    }

    // 畳み込み演算を行う
    vector<ll> convolution(const vector<ll> &a, const vector<ll> &b) {
        int ntt_size = 1;
        while (ntt_size < (int)a.size() + (int)b.size()) ntt_size *= 2;

        vector<ll> _a = a, _b = b;
        _a.resize(ntt_size);
        _b.resize(ntt_size);

        ntt(_a);
        ntt(_b);

        rep(i, ntt_size) {
            (_a[i] *= _b[i]) %= mod;
        }

        intt(_a);
        return _a;
    }
};

ll garner(vector<pair<int, int>> mr, int mod) {
    mr.emplace_back(mod, 0);

    vector<ll> coffs(mr.size(), 1);
    vector<ll> constants(mr.size(), 0);
    rep(i, (int)mr.size() - 1) {
        // coffs[i] * v + constants[i] == mr[i].second (mod mr[i].first) を解く
        ll v = (mr[i].second - constants[i]) *
               inv_mod<ll>(coffs[i], mr[i].first) % mr[i].first;
        if (v < 0) v += mr[i].first;

        for (int j = i + 1; j < (int)mr.size(); j++) {
            (constants[j] += coffs[j] * v) %= mr[j].first;
            (coffs[j] *= mr[i].first) %= mr[j].first;
        }
    }

    return constants[(int)mr.size() - 1];
}

typedef NTT<167772161, 3> NTT_1;
typedef NTT<469762049, 3> NTT_2;
typedef NTT<1224736769, 3> NTT_3;

// 任意のmodで畳み込み演算 O(n log n)
vector<ll> int32mod_convolution(vector<ll> a, vector<ll> b, int mod) {
    for (auto &x : a) x %= mod;
    for (auto &x : b) x %= mod;
    NTT_1 ntt1;
    NTT_2 ntt2;
    NTT_3 ntt3;
    auto x = ntt1.convolution(a, b);
    auto y = ntt2.convolution(a, b);
    auto z = ntt3.convolution(a, b);

    vector<ll> ret(x.size());
    vector<pair<int, int>> mr(3);
    rep(i, x.size()) {
        mr[0].first = ntt1.get_mod(), mr[0].second = (int)x[i];
        mr[1].first = ntt2.get_mod(), mr[1].second = (int)y[i];
        mr[2].first = ntt3.get_mod(), mr[2].second = (int)z[i];
        ret[i] = garner(mr, mod);
    }

    return ret;
}
